rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── REPORTS ───────────────────────────────────────────────
    match /reports/{reportId} {

      // Authenticated users (anonymous or signed-in) can create reports.
      // Session-only users are handled in code with localStorage fallback.
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['user_id', 'urgency_level', 'summary', 'time'])
                    && request.resource.data.user_id == request.auth.uid;

      // Only the owning user can read their own report.
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.user_id;

      // Only the owning user can update, and they cannot change the user_id (immutable).
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.user_id
                    && request.resource.data.user_id == resource.data.user_id;

      // Nobody can delete reports — permanent audit trail.
      allow delete: if false;
    }

    // ─── USERS ─────────────────────────────────────────────────
    match /users/{userId} {
      // Users can only read and write their own profile document.
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // ─── CATCH-ALL — block all other access ────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
